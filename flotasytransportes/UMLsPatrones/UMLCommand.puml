@startuml
title Patrón Command - Sistema de Gestión de Flotas (Frontend)

skinparam classAttributeIconSize 0

' =========================
' COMMAND (Interfaz)
' =========================
class Command {
    + execute() : Object
    + undo() : void
    + getDescripcion() : String
}

note top of Command
  Interfaz que define el contrato
  para todas las operaciones del sistema.
  execute(): ejecuta la operación.
  undo(): revierte la operación.
  getDescripcion(): texto legible para el historial.
end note

' =========================
' CONCRETE COMMANDS
' =========================
class CrearVehiculoCommand {
    - tipo : String
    - vehiculoData : Object
    - placaCreada : String
    + execute() : Object
    + undo() : void
    + getDescripcion() : String
}

class EliminarVehiculoCommand {
    - placa : String
    - datos : Object
    + execute() : Object
    + undo() : void
    + getDescripcion() : String
}

class CambiarEstadoCommand {
    - placa : String
    - nuevoEstado : String
    - estadoAnterior : String
    + execute() : Object
    + undo() : void
    + getDescripcion() : String
}

class CrearOrdenCommand {
    - ordenData : Object
    - resultado : Object
    + execute() : Object
    + undo() : void
    + getDescripcion() : String
}

class CrearReporteCommand {
    - dto : Object
    - resultado : Object
    + execute() : Object
    + undo() : void
    + getDescripcion() : String
}

Command <|.. CrearVehiculoCommand
Command <|.. EliminarVehiculoCommand
Command <|.. CambiarEstadoCommand
Command <|.. CrearOrdenCommand
Command <|.. CrearReporteCommand

' =========================
' INVOKER (Singleton)
' =========================
class CommandHistory {
    - history : List<Command>
    - redoStack : List<Command>
    - listeners : List<Function>
    + ejecutar(command: Command) : Object
    + deshacer() : void
    + rehacer() : void
    + getHistorial() : List<Command>
    + getRedoHistorial() : List<Command>
    + onCambio(callback: Function) : Function
}

note bottom of CommandHistory
  Singleton que recibe comandos,
  los ejecuta y los guarda en
  el historial. Proporciona
  deshacer(), rehacer() y notifica
  cambios a los listeners.
  Al ejecutar un nuevo comando se
  limpia la pila de redo.
end note

CommandHistory --> Command : "ejecuta/deshace/rehace"
CommandHistory --> "varios" : listeners

' =========================
' CLIENTE (Panel visual)
' =========================
class CommandPanel {
    - abierto : boolean
    - comandos : List<Command>
    - redoComandos : List<Command>
    + handleDeshacer() : void
    + handleRehacer() : void
}

note bottom of CommandPanel
  Botón flotante ⚡ en esquina
  inferior derecha. Muestra el
  historial de comandos ejecutados
  con botón "↩ Deshacer" en el
  último comando y "⟳ Rehacer"
  en la parte inferior cuando
  hay comandos rehechos.
end note

CommandPanel --> CommandHistory : "observa"

' =========================
' NOTAS ADICIONALES
' =========================
note right of CrearVehiculoCommand
  Al execute(): llama vehiculosService.createByTipo(),
  guarda la placa creada, emite 'vehiculo:created'.
  Al undo(): elimina el vehículo por placa.
end note

note right of CambiarEstadoCommand
  Al execute(): llama vehiculosService.updateEstado().
  Al undo(): restaura el estadoAnterior.
  Sí tiene undo funcional.
end note

note right of EliminarVehiculoCommand
  Al execute(): obtiene los datos del vehículo
  (vehiculosService.getByPlaca()), lo elimina
  y emite 'vehiculo:deleted'.
  Al undo(): restaura el vehículo llamando
  a vehiculosService.createByTipo() con los
  datos guardados y emite 'vehiculo:created'.
end note

note right of CrearOrdenCommand
  Al execute(): llama ordenesService.crearYAsignar(),
  guarda el resultado, emite 'orden:created'.
  Al undo(): elimina la orden vía backend
  (ordenesService.delete()) y emite 'orden:deleted'.
end note

note right of CrearReporteCommand
  Al execute(): llama reportesService.create(),
  guarda el resultado, emite 'reporte:created'.
  Al undo(): elimina el reporte vía backend
  (reportesService.delete()) y emite 'reporte:deleted'.
end note

@enduml
